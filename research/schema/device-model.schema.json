{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnibuds.local/research/device-model.schema.json",
  "title": "OmniBuds Device Model Research Record",
  "type": "object",
  "required": [
    "company",
    "companySlug",
    "model",
    "slug",
    "formFactor",
    "officialApp",
    "battery",
    "features",
    "controls",
    "sources",
    "confidence",
    "gaps"
  ],
  "properties": {
    "company": { "type": "string" },
    "companySlug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "family": { "type": ["string", "null"] },
    "model": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "generation": { "type": ["string", "null"] },
    "variant": { "type": ["string", "null"] },
    "releaseYear": { "type": ["integer", "null"] },
    "formFactor": {
      "enum": [
        "tws-stem",
        "tws-bud",
        "tws-open",
        "open-ear-hook",
        "open-ear-clip",
        "neckband",
        "over-ear",
        "on-ear",
        "bone-conduction",
        "other"
      ]
    },
    "officialApp": {
      "type": "object",
      "required": ["name", "platforms", "packageIds"],
      "properties": {
        "name": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "enum": ["android", "ios", "windows", "macos", "web"] }
        },
        "packageIds": { "type": "array", "items": { "type": "string" } },
        "appStoreUrls": { "type": "array", "items": { "type": "string" } },
        "appVersionObserved": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "battery": {
      "type": "object",
      "required": ["budsDisplay", "caseDisplay", "caseVisibility", "caseWhileBudsOut"],
      "properties": {
        "budsDisplay": { "enum": ["split", "combined", "unknown"] },
        "caseDisplay": { "enum": ["separate", "combined", "hidden", "unknown"] },
        "caseVisibility": {
          "enum": ["always", "only-when-docked", "only-when-case-open", "only-when-charging", "unknown"]
        },
        "caseWhileBudsOut": { "enum": ["live", "last-known", "hidden", "unknown"] },
        "budsHoursAnc": { "type": ["number", "null"] },
        "budsHoursNoAnc": { "type": ["number", "null"] },
        "caseHours": { "type": ["number", "null"] },
        "hoursBasis": { "enum": ["case-only", "total-with-case", "unknown"] },
        "caseOnlyHours": { "type": ["number", "null"] },
        "totalWithCaseHours": { "type": ["number", "null"] },
        "chargingIndicators": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "anc": {
      "type": "object",
      "properties": {
        "supported": { "type": ["boolean", "null"] },
        "modes": { "type": "array", "items": { "type": "string" } },
        "adaptive": { "type": ["boolean", "null"] },
        "ancDb": { "type": ["number", "null"] },
        "transparencyDb": { "type": ["number", "null"] },
        "personalized": { "type": ["boolean", "null"] },
        "windNoise": { "type": ["boolean", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "availability"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "availability": { "enum": ["official-app", "device-only", "both", "unknown"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "controls": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": { "enum": ["touch", "pinch", "squeeze", "slide", "button", "head-gesture", "voice", "other"] }
        },
        "gestures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gesture", "action"],
            "properties": {
              "gesture": { "type": "string" },
              "action": { "type": "string" },
              "configurableInApp": { "type": ["boolean", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "physicalButtons": { "type": ["string", "null"] },
        "configurableInApp": { "type": ["boolean", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "eqPresets": { "type": "array", "items": { "type": "string" } },
        "customEq": { "type": ["boolean", "null"] },
        "eqBands": { "type": ["integer", "null"] },
        "spatialAudio": { "type": ["boolean", "null"] },
        "headTracking": { "type": ["boolean", "null"] },
        "codecs": { "type": "array", "items": { "type": "string" } },
        "hiRes": { "type": ["boolean", "null"] },
        "multipoint": { "type": ["boolean", "null"] },
        "wearDetection": { "type": ["boolean", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "appOnlyFeatures": { "type": "array", "items": { "type": "string" } },
    "featureDeltaFromPrevious": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "type", "accessed"],
        "properties": {
          "url": { "type": "string" },
          "type": {
            "enum": ["official-product", "official-support", "official-manual", "official-app-store", "official-firmware", "official-regional", "reputable-secondary", "other"]
          },
          "title": { "type": ["string", "null"] },
          "accessed": { "type": "string" }
        }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] },
    "researchedAt": { "type": "string" }
  }
}
