<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header Row: Device Name, Subtitle, Reconnect & Disconnect Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/notif_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="realme Buds T300"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_status_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected • Active"
                android:textColor="#E5FF36"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_btn_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_reconnect"
            android:text="Reconnect"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_disconnect"
            android:text="Disconnect"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Battery Telemetry Row (Shown when expanded - pure colored text, no pill background) -->
    <LinearLayout
        android:id="@+id/notif_battery_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_battery_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L: 100%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_battery_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="• R: 100%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_battery_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="• Case: 85%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Noise Control Buttons: Full-Width Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/notif_btn_anc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_mode_inactive"
            android:text="ANC"
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_btn_ambient"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_mode_active"
            android:text="Ambient"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_btn_transparency"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_mode_inactive"
            android:text="Transparency"
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
