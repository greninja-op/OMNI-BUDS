# Normalise line endings so that a checkout on Windows, Linux or macOS produces
# byte-identical Kotlin sources. Without this, git's autocrlf behaviour on this
# workstation rewrites every file it touches and diffs become noisy.
* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf

# Binary artifacts must never be normalised.
*.jar binary
*.png binary
*.webp binary
*.aar binary
*.pcap binary
*.btsnoop binary
